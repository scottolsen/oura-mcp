# Register an app at https://cloud.ouraring.com/oauth/applications
# Redirect URI to register: http://localhost:8787/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Optional overrides
# OURA_REDIRECT_URI=http://localhost:8787/callback
# OURA_TOKEN_FILE=~/.config/oura-mcp/tokens.json
# OURA_TIMEZONE=America/Chicago

# Optional: use an access token you already have instead of the token file
# (it will not be refreshed automatically).
# OURA_ACCESS_TOKEN=
